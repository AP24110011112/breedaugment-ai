# Optional frontend origin override is managed by backend/main.py.
MAX_UPLOAD_BYTES=15728640
# Render persistent disk path. Keep unset for the default local project folders.
BREEDAUGMENT_DATA_DIR=/var/data
# Comma-separated production frontend origin(s), without trailing slashes.
FRONTEND_ORIGINS=https://your-app.vercel.app
# TensorFlow uses CPU by default. On Apple Silicon, install tensorflow-metal only
# after checking compatibility with the TensorFlow version selected in requirements.txt.
